# 应用配置
APP_NAME=qavor-api
APP_VERSION=1.0.0
APP_MODE=debug                # debug | release | test
APP_PORT=8080

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                # 生产环境必须设置

# PostgreSQL 配置（当前主数据库）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=                # 必填，留空会导致连接失败
POSTGRES_DATABASE=qavor
POSTGRES_SSLMODE=disable

# MinIO 配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=              # 必填
MINIO_SECRET_KEY=              # 必填
MINIO_BUCKET=qavor
MINIO_USE_SSL=false
MINIO_REGION=                  # 部分云环境需要填写，例如 us-east-1

# JWT 配置
JWT_SECRET=                    # 必填，生产环境请使用强随机字符串
JWT_ACCESS_EXPIRE=2            # 访问令牌过期时间（小时）
JWT_REFRESH_EXPIRE=168         # 刷新令牌过期时间（小时），7天

# 日志配置
LOG_LEVEL=debug                # debug | info | warn | error
LOG_FILENAME=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true

# 邮箱配置（SMTP）
EMAIL_SMTP_HOST=smtp.qq.com     # SMTP 服务器地址
EMAIL_SMTP_PORT=465             # SMTP 端口（QQ邮箱SSL端口为465）
EMAIL_SMTP_ACCOUNT=             # 发件人邮箱账号
EMAIL_SMTP_AUTH_CODE=           # 邮箱授权码（非登录密码，需在邮箱设置中获取）
EMAIL_FROM=                     # 发件人邮箱（通常与账号相同）
EMAIL_FROM_NAME=Qavor           # 发件人名称
