# 应用配置
APP_NAME=qavor-api
APP_VERSION=1.0.0
APP_MODE=debug                # debug | release | test
APP_PORT=8080

# 单实例管理员配置
QAVOR_AUTH_ADMIN_USERNAME=change-me
QAVOR_AUTH_ADMIN_PASSWORD=change-me

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                # 生产环境必须设置

# PostgreSQL 配置（当前主数据库）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=                # 必填，留空会导致连接失败
POSTGRES_DATABASE=qavor
POSTGRES_SSLMODE=disable

# MinIO 配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=              # 必填
MINIO_SECRET_KEY=              # 必填
MINIO_BUCKET=qavor
MINIO_USE_SSL=false
MINIO_REGION=                  # 部分云环境需要填写，例如 us-east-1
MINIO_PUBLIC_ENDPOINT=http://localhost:9000  # 对外访问地址
MINIO_MAX_FILE_SIZE=52428800                 # 50MB

# JWT 配置
JWT_SECRET=                    # 必填，生产环境请使用强随机字符串
JWT_EXPIRE_HOURS=24

# 日志配置
LOG_LEVEL=debug                # debug | info | warn | error
LOG_FILENAME=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true

# RAG 算法默认配置；模型在知识库创建时绑定
RAG_CHUNK_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=100
RAG_TOP_K=5
RAG_REQUEST_TIMEOUT_SECONDS=60
RAG_EMBEDDING_BATCH_SIZE=15

# ========== 联网搜索工具 ==========
# Provider: tavily | brave，默认 tavily
WEB_SEARCH_PROVIDER=tavily

# API 基础地址：必须显式配置（代码中无默认值）
#   tavily 官方：https://api.tavily.com
#   brave  官方：https://api.search.brave.com
# 企业/自托管场景可填反向代理地址
WEB_SEARCH_BASE_URL=https://api.tavily.com

# 搜索 API Key（建议通过环境变量注入，避免泄露到代码仓库）
# 获取方式见 docs/Task-11-WebSearch联网搜索工具设计文档.md 附录 A
# 优先级：WEB_SEARCH_API_KEY > QAVOR_WEB_SEARCH_API_KEY > config.yaml
# 留空时：debug 模式使用 Mock Provider，release 模式不注册搜索工具
WEB_SEARCH_API_KEY=
