# ============================================================
# Qavor Docker 环境变量模板
#   使用方式：cp .env.example .env && 修改值
#   ⚠️ .env 文件不要提交到 Git（已在 .gitignore 中）
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=qavor

# ---- Redis ----
REDIS_PASSWORD=

# ---- MinIO (对象存储) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-to-a-strong-password
MINIO_ACCESS_KEY=change-me-to-a-strong-password
MINIO_SECRET_KEY=change-me-to-a-strong-password

# ---- LLM / Embedding API ----
# OpenAI 兼容接口
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 火山引擎 (Ark)
ARK_API_KEY=

# ---- 联网搜索 ----
WEB_SEARCH_API_KEY=

# ---- JWT 密钥（生产环境务必修改） ----
JWT_SECRET=change-me-to-a-random-base64-string

# ---- 初始管理员账号（首次启动自动创建） ----
QAVOR_AUTH_ADMIN_USERNAME=admin
QAVOR_AUTH_ADMIN_PASSWORD=change-me-too

# ---- MinIO bucket 名 ----
MINIO_BUCKET=qavor

# ---- SMTP 邮件（可选） ----
SMTP_ACCOUNT=
SMTP_AUTH_CODE=

# ---- 镜像仓库 (CD 用) ----
# GHCR: 自动通过 GITHUB_TOKEN 认证，不需要额外配置
# 如用 Docker Hub，取消注释并填入：
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=
