# 应用配置
app:
  name: "qavor-api"
  version: "1.0.0"
  mode: "debug"                    # debug | release | test
  port: 8080

# 单实例管理员配置（真实值请写入不提交的 config.yaml 或环境变量）
auth:
  admin_username: "change-me"
  admin_password: "change-me"

# 数据库配置
database:
  auto_migrate: false  # 是否自动迁移数据库，设为 false 可跳过每次启动时的迁移
  redis:
    host: "localhost"
    port: 6379
    password: ""                   # 生产环境通过环境变量 REDIS_PASSWORD 注入
    db: 0
    pool_size: 10
  postgres:
    host: "localhost"
    port: 5432
    username: "postgres"
    password: ""                   # 生产环境通过环境变量 POSTGRES_PASSWORD 注入
    database: "qavor"
    sslmode: "disable"
    max_idle_conns: 10
    max_open_conns: 100
  minio:
    endpoint: "localhost:9000"
    access_key: ""                 # 生产环境通过环境变量 MINIO_ACCESS_KEY 注入
    secret_key: ""                 # 生产环境通过环境变量 MINIO_SECRET_KEY 注入
    bucket: "qavor"
    use_ssl: false
    region: ""
    public_endpoint: "http://localhost:9000"  # 对外访问地址，拼接返回给前端的文件 URL
    max_file_size: 52428800                   # 最大文件大小（字节），默认 50MB
    allowed_types:                            # 允许的 MIME 类型，空列表=不限制
      # - "image/*"
      # - "application/pdf"
      # - "text/*"

# JWT 配置
jwt:
  secret: ""                       # 生产环境通过环境变量 JWT_SECRET 注入，必须设置
  access_expire: 2                 # 访问令牌过期时间（小时）
  refresh_expire: 168              # 刷新令牌过期时间（小时），7天

# 日志配置
log:
  level: "info"                    # debug | info | warn | error
  filename: "logs/app.log"
  max_size: 100                    # 单个日志文件最大大小（MB）
  max_backups: 3                   # 保留旧文件的最大个数
  max_age: 28                      # 保留旧文件的最大天数
  compress: true                   # 是否压缩

# CORS 配置
cors:
  enabled: true
  allow_origins:
    - "http://localhost:3000"      # 生产环境不要使用 "*"
  allow_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "DELETE"
    - "OPTIONS"
  allow_headers:
    - "Origin"
    - "Content-Type"
    - "Authorization"

# 邮件配置
# SMTP 服务器配置说明：
# - QQ 邮箱：smtp.qq.com，端口 465（SSL）或 587（STARTTLS）
# - 163 邮箱：smtp.163.com，端口 465（SSL）
# - Gmail：smtp.gmail.com，端口 465（SSL）或 587（STARTTLS）
# - 授权码获取方式：登录邮箱后，在设置 -> 账户 -> POP3/SMTP 服务中开启并获取授权码
email:
  smtp:
    host: "smtp.qq.com"             # SMTP 服务器地址
    port: 465                       # SMTP 端口（SSL）
    account: ""                     # 邮箱账号（如：your-email@qq.com）
    auth_code: ""                   # 邮箱授权码（非登录密码），生产环境通过环境变量 EMAIL_AUTH_CODE 注入
  from: ""                          # 发件人邮箱（通常与 account 相同）
  from_name: "Qavor"                # 发件人名称

# MCP 配置
mcp:
  tool_retrieval:
    enabled: false                  # 是否开启 MCP 工具向量检索
    threshold: 20                   # 工具数 ≤ 此值时全量注入，超过才启用检索
    top_k: 10                       # 每次检索选择的工具数量
    embedding_provider: ""          # embedding 供应商 provider_id（如 openai）
    embedding_model: ""             # embedding 模型名（如 text-embedding-3-small）

# LLM 配置（统一接口，通过 provider 切换不同厂商）
llm:
  provider: "openai"                          # 厂商类型：openai | deepseek | moonshot | ollama
  model: "gpt-4o"                             # 模型名称
  api_key: ""                                 # API 密钥（通过环境变量 LLM_API_KEY 覆盖）
  base_url: ""                                # API 基础地址（可选，OpenAI 默认使用官方地址）
  timeout: 60000                              # 请求超时时间（毫秒）
  temperature: 0.7                            # 温度参数 (0-2)
  max_tokens: 2048                            # 最大生成 token 数
  top_p: 1.0                                  # Top P 采样
  stop: []                                    # 停止词
  presence_penalty: 0                         # 存在惩罚 (-2.0 到 2.0)
  frequency_penalty: 0                        # 频率惩罚 (-2.0 到 2.0)
  provider_config:                            # 厂商特有参数（按厂商不同而不同）
    seed: null                                # [OpenAI] 随机种子
    user: null                                # [OpenAI] 用户标识
    response_format: null                     # [OpenAI] 响应格式
    extra_fields: {}                          # [OpenAI] 额外字段

# Embedding 配置（用于文本向量化）
embedding:
  provider: "openai"                          # 厂商类型：openai
  model: "text-embedding-3-small"             # 模型名称
  api_key: ""                                 # API 密钥
  base_url: ""                                # API 基础地址（可选）
  timeout: 60000                              # 请求超时时间（毫秒）
  dimensions: 1536                            # 向量维度

# Ollama 配置（本地模型，可选）
ollama:
  base_url: "http://localhost:11434"          # Ollama 服务地址
  model: "llama3"                             # 默认模型