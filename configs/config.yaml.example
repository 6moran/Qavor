# 应用配置
app:
  name: "qavor-api"
  version: "1.0.0"
  mode: "debug"  # debug, release, test
  port: 8080
  skills_dir: ""  # Skill 文件目录，留空默认使用工作目录下 qavor/skills；支持 ~ 前缀展开

auth:
  admin_username: "change-me"
  admin_password: "change-me"

# 数据库配置
database:
  auto_migrate: false  # 是否自动迁移数据库，设为 false 可跳过每次启动时的迁移
  redis:
    host: "39.105.40.22"
    port: 6379
    password: ""                              # 通过环境变量 REDIS_PASSWORD 覆盖
    db: 0
    pool_size: 10
  postgres:
    host: "39.105.40.22"
    port: 5432
    username: "postgres"
    password: ""                              # 通过环境变量 POSTGRES_PASSWORD 覆盖
    database: "qavor"
    sslmode: "disable"
    max_idle_conns: 10
    max_open_conns: 100
  minio:
    endpoint: "39.105.40.22:9000"
    access_key: ""                            # 通过环境变量 MINIO_ACCESS_KEY 覆盖
    secret_key: ""                            # 通过环境变量 MINIO_SECRET_KEY 覆盖
    bucket: "qavor"
    use_ssl: false
    region: ""
    public_endpoint: "http://39.105.40.22:9000"  # 对外访问地址，拼接返回给前端的文件 URL
    max_file_size: 52428800                   # 最大文件大小（字节），默认 50MB
    allowed_types:                            # 允许的 MIME 类型，空列表=不限制
      # - "image/*"
      # - "application/pdf"
      # - "text/*"

# 文档异步处理队列
document_queue:
  parse_stream: "qavor:document:parse"
  parse_group: "qavor-document-parse-workers"
  read_block_seconds: 5
  pending_check_seconds: 60
  pending_min_idle_minutes: 30
  pending_claim_count: 10
  max_stream_length: 100000

# JWT 配置
jwt:
  secret: "your-jwt-secret-key-change-in-production"  # JWT 密钥，生产环境请修改
  expire_hours: 2                                      # 访问令牌过期时间（小时）

# 日志配置
log:
  level: "debug"  # debug, info, warn, error
  filename: "logs/app.log"
  max_size: 100    # MB
  max_backups: 3   # 保留旧文件的最大个数
  max_age: 28      # 保留旧文件的最大天数
  compress: true   # 是否压缩

# CORS 配置
cors:
  enabled: true
  allow_origins:
    - "*"
  allow_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "DELETE"
    - "OPTIONS"
  allow_headers:
    - "Origin"
    - "Content-Type"
    - "Authorization"

# LLM 配置
llm:
  model: "gpt-4o"                             # 模型名称
  api_key: ""                                 # API 密钥（通过环境变量 LLM_API_KEY 覆盖）
  base_url: ""                                # API 基础地址（可选，OpenAI 默认使用官方地址）
  timeout: 60s                                # 请求超时时间
  temperature: 0.7                            # 温度参数 (0-2)
  max_completion_tokens: 2048                 # 最大 token 数（包含推理 token）
  top_p: 1.0                                  # Top P 采样
  stop: []                                    # 停止词
  presence_penalty: 0                         # 存在惩罚 (-2.0 到 2.0)
  frequency_penalty: 0                        # 频率惩罚 (-2.0 到 2.0)
  seed: null                                  # 随机种子（用于可重现的结果）
  user: null                                  # 用户标识

# Agent 配置（本地文件系统与安全管控）
agent:
  workspace_root: "data/workspaces"           # agent 默认工作区根，每 agent 下建 <slug> 子目录
  security:
    enabled: true                             # 安全管控总开关
    shell_timeout_seconds: 0                  # 单条 shell 命令超时秒数（0=无显式超时，依赖后台任务前台超时兜底）
    credentials:
      enabled: true                           # 凭据路径守卫（.env、私钥、secret/token 等）
      extra_patterns: []                      # 追加的敏感路径/文件名模式
    command:
      enabled: true                           # 高危命令黑名单（rm -rf /、dd 擦盘、shutdown 等）
      extra_bans: []                          # 追加的高危命令词
    redaction:
      enabled: true                           # 输出脱敏（KEY=xxx 键值对 + 敏感环境变量值）
      extra_env_keys: []                      # 追加脱敏的环境变量名
    syntax:
      enabled: true                           # 写前语法预检（JSON/YAML 非法阻断，Go 引入新错误警告）
    staleness:
      enabled: true                           # 陈旧警告（文件被外部修改时提示，不阻断）
    line_prefix:
      enabled: true                           # read 行号前缀检测（阻止写入时混入行号前缀）
    exit_code:
      enabled: true                           # 退出码语义解释（grep 无匹配等信息性退出码不标失败）
    output:
      max_bytes: 51200                        # shell 输出截断阈值（字节），默认 50KB
      offload_token_limit: 20000              # 大工具结果落盘 token 阈值

# SSE 流式服务配置
sse:
  max_stream_time: 300                        # 单次流式最大时长（秒），默认 300（5分钟）
  heartbeat_interval: 15                      # 心跳间隔（秒），默认 15
  max_concurrent_tasks: 5                     # 单用户最大并发任务数，默认 5

# MCP 配置
mcp:
  tool_retrieval:
    enabled: false                  # 是否开启 MCP 工具向量检索
    threshold: 20                   # 工具数 ≤ 此值时全量注入，超过才启用检索
    top_k: 10                       # 每次检索选择的工具数量
    embedding_provider: ""          # embedding 供应商 provider_id（如 openai）
    embedding_model: ""             # embedding 模型名（如 text-embedding-3-small）

# Embedding 配置（用于文本向量化）
embedding:
  provider: "openai"                          # 厂商类型：openai
  model: "text-embedding-3-small"             # 模型名称
  api_key: ""                                 # API 密钥
  base_url: ""                                # API 基础地址（可选）
  timeout: 60000                              # 请求超时时间（毫秒）
  dimensions: 1536                            # 向量维度

# Ollama 配置（本地模型，可选）
ollama:
  base_url: "http://localhost:11434"          # Ollama 服务地址
  model: "llama3"                             # 默认模型

# RAG 算法默认配置；模型必须在创建知识库时通过模型 ID 绑定。
rag:
  chunk_tokens: 800
  chunk_overlap_tokens: 100
  top_k: 5
  request_timeout_seconds: 60
  embedding:
    batch_size: 15

# 链路追踪：Middleware 管理 HTTP Span、AgentRuntime 管理 Agent Run Span、eino Callback 管理组件 Span
trace:
  enabled: true             # 总开关，关闭后不注册 Handler/中间件/janitor，Agent/Run 行为不受影响
  content_mode: summary     # 内容模式：none（不保存摘要）/ summary（按 Unicode rune 截断）
  max_content_length: 500   # 内容字段截断长度（字符）
  retention_days: 7         # 数据保留天数，过期物理删除（按 trace_records.expires_at）
  timeout_minutes: 30       # running Span 超过此时长标记为 timeout
  janitor_interval: 5       # 清理任务执行间隔（分钟）
  writer_buffer_size: 2048  # Writer 异步队列缓冲区大小
  traced_routes:            # 需追踪的 HTTP 路由（method + path 精确匹配）
    - "POST /api/v1/chat"
    - "POST /api/v1/chat/call"
    - "POST /api/v1/chat/stream"
    - "POST /api/v1/agent/runs"

# 联网搜索工具配置
# 所有字段优先从环境变量读取（WEB_SEARCH_PROVIDER / WEB_SEARCH_BASE_URL / WEB_SEARCH_API_KEY），
# 其次读本文件，代码中不内置 BaseURL 默认值。
web_search:
  provider: "tavily"        # tavily | brave，默认 tavily
  base_url: ""              # 必须显式配置（环境变量或此处），代码中无默认值
                           #   tavily 官方：https://api.tavily.com
                           #   brave  官方：https://api.search.brave.com
                           # 企业/自托管场景可填反向代理地址
  api_key: ""               # 留空则读取环境变量，都为空时不注册搜索工具
                           # debug 模式使用 Mock Provider，release 模式不注册


